// Pufflet — Telegram-backed personal cloud storage
// SQLite build (default). For serverless hosts (Vercel) use
// prisma/schema.postgres.prisma — keep the two models in sync; the models here
// are the source of truth and are portable across both providers.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                  String       @id @default(cuid())
  email               String       @unique
  name                String?
  passwordHash        String
  role                String       @default("OWNER") // OWNER | MEMBER (multi-workspace ready)
  mustChangePassword  Boolean      @default(false) // true for the seeded default account until the password is changed
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  sessions    Session[]
  folders     Folder[]
  files       File[]
  uploadJobs  UploadJob[]
  apiKeys     ApiKey[]
  auditEvents AuditEvent[]
  rcloneRemotes RcloneRemote[]
  rcloneJobs    RcloneJob[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique // 48 random bytes, hex — raw token lives only in the cookie
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Folder {
  id        String    @id @default(cuid())
  name      String
  ownerId   String
  owner     User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    Folder?   @relation("FolderTree", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children  Folder[]  @relation("FolderTree")
  trashedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  files File[]

  @@index([ownerId, parentId])
  @@index([ownerId, trashedAt])
}

model File {
  id             String    @id @default(cuid())
  name           String // original filename (display)
  normalizedName String // lowercased for case-insensitive search/sorting
  size           Int // bytes (upload cap keeps this within Int32)
  mimeType       String    @default("application/octet-stream")
  status         String    @default("UPLOADING") // UPLOADING | READY | FAILED
  starred        Boolean   @default(false)
  ownerId        String
  owner          User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  folderId       String?
  folder         Folder?   @relation(fields: [folderId], references: [id], onDelete: SetNull)
  trashedAt      DateTime?
  sha256         String? // optional content checksum (never the Telegram file id)
  uploaderLabel  String? // "web" or "api" provenance

  // Telegram storage references — chat/message locate the stored message,
  // file_id is a bot-scoped download handle, file_unique_id is an index key.
  tgChatId       String?
  tgMessageId    String?
  tgFileId       String?
  tgFileUniqueId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shareLinks ShareLink[]

  @@index([ownerId, folderId, trashedAt])
  @@index([ownerId, status])
  @@index([ownerId, trashedAt, updatedAt])
  @@index([normalizedName])
  @@index([tgFileUniqueId])
}

// Public share links: unguessable capability tokens in the URL. Anyone with
// the link can download the file WITHOUT logging in; the owner can revoke.
model ShareLink {
  id             String    @id @default(cuid())
  token          String    @unique // 43-char base64url of 32 random bytes — the URL secret
  fileId         String
  file           File      @relation(fields: [fileId], references: [id], onDelete: Cascade)
  createdBy      String // owner user id at creation time
  createdAt      DateTime  @default(now())
  revokedAt      DateTime?
  expiresAt      DateTime?
  downloads      Int       @default(0)
  lastDownloadAt DateTime?

  @@index([fileId])
}

model UploadJob {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  filename  String
  size      Int
  mimeType  String?
  folderId  String?
  status    String    @default("PENDING") // PENDING | UPLOADING | STORING | READY | FAILED | CANCELED
  error     String?
  fileId    String? // set when the job completes
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId, status])
}

model ApiKey {
  id         String    @id @default(cuid())
  name       String
  prefix     String // non-secret display/lookup prefix, e.g. tc_live_ab12
  hash       String    @unique // sha256 hex of the full secret
  scopes     String    @default("read,write") // comma-joined: read,write,delete,admin
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime?
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model AuditEvent {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String // e.g. file.upload, file.trash, key.create, auth.login
  target    String? // resource id
  detail    String? // short non-sensitive context
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model Setting {
  key       String   @id // e.g. "vault.masterKey" (base64 of the 256-bit vault key)
  value     String
  updatedAt DateTime @updatedAt
}

// rclone remotes — user-configured external storage backends (S3, Google
// Drive, SFTP, ...). Provider options (including secrets) are stored as an
// AES-256-GCM encrypted JSON blob in configEnc; they NEVER leave the server
// in API responses (only masked summaries are returned).
model RcloneRemote {
  id            String    @id @default(cuid())
  ownerId       String
  owner         User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name          String    @unique // rclone remote name, [a-z0-9-] only
  type          String // backend type: s3, gdrive, sftp, local, ...
  configEnc     String // encrypted JSON of provider options (never plaintext)
  status        String    @default("unknown") // unknown | ok | error
  lastError     String? // sanitized message from the last connectivity check
  lastCheckedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  jobs RcloneJob[]

  @@index([ownerId])
}

// Background rclone sync jobs: push (Pufflet folder -> remote) and pull
// (remote -> Pufflet folder). Progress lives on the row so clients poll it
// like any upload job.
model RcloneJob {
  id         String       @id @default(cuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  remoteId   String
  remote     RcloneRemote @relation(fields: [remoteId], references: [id], onDelete: Cascade)
  kind       String // push | pull
  remotePath String // root path on the remote ("" = remote root)
  folderId   String? // Pufflet folder root (push source / pull target)
  status     String       @default("QUEUED") // QUEUED | RUNNING | DONE | FAILED | CANCELED
  totalFiles Int          @default(0)
  doneFiles  Int          @default(0)
  skipped    Int          @default(0) // skipped (too large / invalid name)
  failed     Int          @default(0) // per-file failures (job continues)
  bytes      BigInt       @default(0) // cumulative transferred bytes
  lastError  String? // most recent per-file error (sanitized)
  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([userId, status])
  @@index([remoteId])
}
