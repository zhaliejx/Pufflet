# Pufflet environment — placeholders only. Copy to .env and fill in.
# NEVER commit your real .env to source control.

# SQLite database (default dev setup)
DATABASE_URL="file:./db/pufflet.db"
# For PostgreSQL (Render Postgres, Neon, Supabase, ... — see README "Deploying"):
#   the Docker image auto-detects postgres:// URLs at boot and regenerates the
#   Prisma client for PostgreSQL automatically (bare Node setups: run
#   `prisma generate --schema prisma/schema.postgres.prisma` first).
#   DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# --- First-run default account -----------------------------------------------
# On first boot Pufflet seeds an owner account:
#   pufflet@pufflet.com  /  pufflet   (temporary — change it in Settings -> Account)
# Set to "false" to disable seeding and use the classic first-run setup screen.
SEED_DEFAULT_USER="true"

# --- Telegram storage (SERVER-ONLY SECRETS) --------------------------------
# 1. Create a bot with @BotFather -> keep the token private.
# 2. Create a PRIVATE channel/group (or use your Saved Messages chat),
#    add the bot as an administrator with post + delete-message permissions.
# 3. Get the chat id: add the bot to the chat, then open
#    https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates and read
#    message.chat.id (channels usually look like -100xxxxxxxxxx).
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Base URL of the Bot API.
#  - Hosted (default):        https://api.telegram.org
#                             upload <= 50 MB / file, download <= 20 MB / file
#  - Bundled Local Bot API server (docker compose up -d — see README):
#                             http://bot-api:8081  (up to 2000 MB both ways)
#  - Remote self-hosted (Render / Fly.io / any always-on Docker host):
#                             https://your-bot-api.onrender.com
#                             (up to 2000 MB both ways; server MUST run with --local)
TELEGRAM_API_BASE="https://api.telegram.org"

# --- Local Bot API server (docker compose) ----------------------------------
# Create an app at https://my.telegram.org -> "API development tools" to get
# these two values; docker-compose.yml passes them to the bot-api sidecar.
# After filling them in, run `npm run tg:logout` ONCE, then `docker compose up -d`.
TELEGRAM_API_ID=""
TELEGRAM_API_HASH=""

# Limits (MB per file) — hosted Bot API: 50 up / 20 down; Local Bot API: 2000.
# On Vercel the serverless request body is capped at ~4.5 MB, so keep
# MAX_UPLOAD_MB at or below 4 there (see README).
MAX_UPLOAD_MB="50"
MAX_DOWNLOAD_MB="20"

# --- Google Drive import (Upload ▾ → From Google Drive) ---------------------
# No configuration needed for normal use — imports hit Google's public
# download endpoint directly. This override exists ONLY for the automated
# end-to-end tests: point it at the telegram-mock's fake Drive to run the
# suite without internet (see mini-services/telegram-mock).
# PUFFLET_GDRIVE_BASE="http://127.0.0.1:3031/fake-gdrive"

# --- rclone storage integration --------------------------------------------
# Bridges external backends (S3, Google Drive, SFTP, WebDAV, ...) into Pufflet.
# Configure remotes in Settings -> rclone Storage; credentials are stored
# AES-256-GCM encrypted and are never returned by the API. Disable with "false".
PUFFLET_RCLONE="true"
# Where the rclone binary lives (default: "rclone" on PATH; the Docker image
# ships it). Point this at a full path when the binary is elsewhere.
PUFFLET_RCLONE_PATH="rclone"

# --- WebDAV server ("Pufflet as a remote") ----------------------------------
# Serves YOUR Pufflet storage at /api/dav so external rclone installations
# (webdav backend, vendor=other) or any WebDAV client can mount this instance
# as a remote. Auth is HTTP Basic where the password is an API key; its scopes
# decide what the client may do (read=PROPFIND/GET, write=PUT/MKCOL/MOVE/COPY,
# delete=DELETE). Disable the whole mount with "false" (answers 404).
PUFFLET_DAV="true"

# --- Vault (at-rest encryption & obfuscation) -------------------------------
# Every uploaded file is AES-256-GCM encrypted, randomly padded (0-64 KiB), and
# stored in the channel under an opaque name (pf-….bin). Downloads decrypt
# transparently; files uploaded before the vault existed still download fine.
# Disable NEW-file encryption with "false" (existing containers still decrypt).
PUFFLET_ENCRYPTION="true"
# OPTIONAL passphrase: the vault key is scrypt-derived from it and is NEVER
# stored in the database or the state snapshot. If you set this, keep it safe —
# losing it makes every vault-encrypted file undecryptable. Leave unset for
# zero-setup mode: a random 256-bit key is generated on first upload, stored in
# the Setting table, and carried inside the state-backup snapshot.
PUFFLET_ENCRYPTION_KEY=""

# --- State backup (self-healing index; free ephemeral hosts) ----------------
# Snapshots the metadata index (users, folders, file records, API keys) into
# ONE pinned document inside the storage chat, refreshed automatically after
# changes. A fresh container finds that pinned snapshot via getChat() and
# restores itself — this is what makes free ephemeral hosts (Hugging Face
# Spaces, Render, Koyeb) work without a VPS.
# Keep it on unless you have your own DB backup strategy; recommended "false"
# on Vercel (cold starts + hosted Postgres make it pointless there).
STATE_BACKUP="true"
# How often unsaved changes are flushed (milliseconds).
STATE_BACKUP_INTERVAL_MS="60000"

# Session lifetime for website sign-ins
SESSION_TTL_DAYS="30"
